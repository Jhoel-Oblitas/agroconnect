# Servidor
PORT=4000
NODE_ENV=development

# Base de datos SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Seguridad JWT (Cambiar en producción por una cadena segura de 32+ caracteres)
JWT_SECRET="cambia_este_secreto_por_uno_largo_y_seguro_en_produccion"
JWT_EXPIRES_IN="12h"

# URL del Frontend (para CORS y enlaces de códigos QR de trazabilidad)
FRONTEND_URL="http://localhost:5173"

# === AGENTE DE IA (Opcional - Si no se configura, funciona el motor NLP local inteligente) ===
# Opción 1 (Recomendada y gratuita): Groq API -> https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Opción 2: Anthropic Claude API -> https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# === INTEGRACIÓN WHATSAPP (Opcional - Sin estas claves funciona el Simulador WhatsApp en la web) ===
# Opción A: Meta WhatsApp Business Cloud API
WHATSAPP_VERIFY_TOKEN="agroconnect_verify_token_2026"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Opción B: Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
